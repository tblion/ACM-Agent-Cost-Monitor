<!-- Defines the .NET backend build and publish configuration. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="10.0.12" />
    <PackageReference Include="SQLitePCLRaw.provider.sqlite3" Version="3.0.5" />
    <PackageReference Include="SQLitePCLRaw.provider.winsqlite3" Version="3.0.5" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <Compile Remove="PackagingProbe/**/*.cs" />
    <EmbeddedResource Include="Resources/pricing.json">
      <LogicalName>OpencodeCostsViewer.Backend.Resources.pricing.json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
